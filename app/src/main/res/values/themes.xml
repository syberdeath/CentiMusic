<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CentiMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nm_offwhite</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- System launch screen (all API levels via core-splashscreen). AnimatedSplash continues from it. -->
    <style name="Theme.CentiMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nm_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.CentiMusic</item>
    </style>
</resources>
