   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#0F1A14"
   }
  },
  {
   "id": "landcover-grass",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "grass",
      "wood",
      "farmland"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#0F1A14"
   }
  },
  {
