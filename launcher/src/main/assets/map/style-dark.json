{
 "version": 8,
 "name": "HKM Dark",
 "glyphs": "asset://map/fonts/{fontstack}/{range}.pbf",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "{{TILES}}",
   "attribution": "© OpenStreetMap contributors"
  }
 },
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#0D1117"
   }
  },
  {
